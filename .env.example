# Copy to .env.local. Localhost uses the production Supabase project.

# Supabase Auth. The URL and publishable key (sb_publishable_...) are safe in the browser; RLS guards the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access (waitlist, rate limits, uploads). Same project as above; never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only secret for rate-limit keys (HMAC-SHA256 of IPs and emails). `openssl rand -hex 32`.
RATE_LIMIT_HMAC_SECRET=

# Report reading (server-only).
ANTHROPIC_API_KEY=

# Invite emails, and auth email when running `supabase config push` (server-only).
RESEND_API_KEY=

# Sentry error tracking. Without it, Sentry never starts. Not secret (it's copied into the browser bundle).
SENTRY_DSN=

# Database tests (npm test): local Supabase's URL and keys, from `npx supabase status -o env`.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
