# Set to true to show internal dev tools (role switcher, demo reset) in the sidebar.
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# Waitlist signups go to the Supabase `waitlist` table (create it with supabase/waitlist.sql).
# SUPABASE_SECRET_KEY is the project's secret key (sb_secret_...); server-only, never NEXT_PUBLIC.
# Required in production; in development signups fall back to .data/waitlist.jsonl.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
