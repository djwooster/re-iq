# Set to true to show internal dev tools (role switcher, demo reset) in the sidebar.
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# Server-only Supabase access: waitlist signups (supabase/waitlist.sql) and auth rate limits.
# SUPABASE_SECRET_KEY is the project's secret key (sb_secret_...); never NEXT_PUBLIC.
# Must be the SAME project as NEXT_PUBLIC_SUPABASE_URL (staging locally and on previews), or
# rate limiting switches itself off. In development without them, waitlist signups go to .data/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Auth (use the STAGING project locally and on previews, never production).
# The URL and publishable key (sb_publishable_...) are safe in the browser; RLS guards the data.
# Leave both empty to keep the old demo sign-in (any credentials enter the sample portfolio).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret for rate-limit keys (HMAC-SHA256 of IPs and emails). 32+ random bytes, e.g.
# `openssl rand -hex 32`. A different value per environment; rotating it just resets the counters.
RATE_LIMIT_HMAC_SECRET=

# Database tests (npm test): the STAGING project's URL and keys. Tests refuse to run against production.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
